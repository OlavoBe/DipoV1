# ============================================================
# DIPO — INDICAÇÕES LEGISLATIVAS
# Copie para .env e preencha. NUNCA commite o .env.
# Variáveis de desenvolvimento/teste vão em .env.local (ver .env.local.example)
# ============================================================

# ─────────────────────────────────────────────────────────────
# Banco de dados (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Local:            postgresql://postgres:senha@localhost:5432/dipov1?schema=public
# Railway/Supabase: cole a connection string fornecida pelo serviço
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─────────────────────────────────────────────────────────────
# LLM (Modelo de Linguagem)
# ─────────────────────────────────────────────────────────────

# Chave de API — obrigatória para gerar indicações
# Anthropic: https://console.anthropic.com/
# OpenAI:    https://platform.openai.com/api-keys
LLM_API_KEY=

# Provider: anthropic | openai (padrão: anthropic)
LLM_PROVIDER=openai

# Modelo para EXTRAÇÃO de dados (barato e rápido)
# Anthropic: claude-3-5-haiku-20241022 | OpenAI: gpt-4o-mini
LLM_MODEL_EXTRACT=gpt-4o-mini

# Modelo para GERAÇÃO do texto formal (mais qualidade)
# Anthropic: claude-sonnet-4-5-20250929 | OpenAI: gpt-4o
LLM_MODEL_GENERATE=gpt-4o

# ─────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────

# Gere com: openssl rand -base64 32
# (AUTH_SECRET também é aceito e tem precedência)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Resend (magic link por e-mail)
# ─────────────────────────────────────────────────────────────

# https://resend.com/api-keys
RESEND_API_KEY=
# Ex: 'Dipo <noreply@seudominio.com>'
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────
# Mercado Pago (checkout dos planos pagos)
# ─────────────────────────────────────────────────────────────

# Produção: Access Token de produção. Dev: use as credenciais de TESTE.
MERCADOPAGO_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# Chromium (geração de PDF em serverless) — opcional
# ─────────────────────────────────────────────────────────────

# Sobrescreve a URL do pack do @sparticuz/chromium usada na Vercel/Lambda.
# Em dev local não é usada (o Playwright usa o binário instalado).
# CHROMIUM_EXECUTABLE_PATH=
